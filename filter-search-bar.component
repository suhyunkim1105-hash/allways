<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Filter Search Bar — Standalone Component</title>
<style>
  /* ============================================================
     Region / Category / Accessibility options render as rounded
     chip/pill buttons (gray = unselected, blue = selected — see
     the "CHIP / PILL BUTTON STYLES" block below). Travel Schedule
     stays a bordered dropdown-style trigger, not a chip, per spec.

     All JS hooks use `data-*` attributes, never classes, so every
     class below (`.filter-bar__*`, `.verdict-badge*`) can still be
     freely restyled or renamed without touching behavior.

     Accessibility now renders using the REAL verdict-badge
     component (owner: 명진), inlined verbatim below in the
     "VERDICT-BADGE COMPONENT" section so this file stays a single
     self-contained document — swap that block out for a real
     <link rel="stylesheet" href="components/verdict-badge/verdict-badge.css">
     once it's hosted at a stable URL, instead of copy-pasting future
     updates in here by hand.

     verdict-badge.css only styles a static badge (color + icon +
     label); it has no notion of "selected". The small
     "FILTER-BAR ADDITIONS ON TOP OF VERDICT-BADGE" block right
     after it is ours: it resets the badge back to plain
     inline-flex layout (no gray/blue pill wrapper — the verdict
     colors ARE the pill now) and adds a persistent inset ring,
     reusing verdict-badge's own hover border style, to mark
     "currently selected" without inventing a new color language.
     ============================================================ */

  /* APHont is not distributed via Google Fonts or any public CDN — it
     must be self-hosted. Point src at wherever the licensed font files
     are placed (NASA distributes APHont for free, but confirm the
     license covers your intended use before shipping it). Regular and
     Bold weights shown; add Italic/Bold-Italic the same way if needed. */
  @font-face {
    font-family: "APHont";
    src: url("fonts/aphont-regular.woff2") format("woff2"),
         url("fonts/aphont-regular.woff") format("woff");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "APHont";
    src: url("fonts/aphont-bold.woff2") format("woff2"),
         url("fonts/aphont-bold.woff") format("woff");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  * { box-sizing: border-box; }

  /* Standalone-preview-only spacing so the Accessibility tooltip
     (which opens upward) has room above it in this demo file; has no
     effect on the reusable <section class="filter-bar"> markup once
     copied into a host page. */
  body {
    margin: 0;
    padding: 10rem 1.5rem 2rem;
  }

  .filter-bar {
    font-family: "APHont", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .filter-bar__form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-bar__group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 11rem;
    flex: 1 1 12rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-bar__legend {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    margin: 0 0 0.125rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #111827;
  }

  .filter-bar__options {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .filter-bar__option {
    position: relative;
    display: inline-flex;
  }

  /* The checkbox itself is invisible (opacity: 0, not display: none)
     but stays on top of the pill and fully interactive, so the chip
     remains a real, keyboard-reachable checkbox for assistive tech —
     only its default browser appearance is hidden, per "hide the raw
     input" while keeping it functionally/accessibly present. */
  .filter-bar__checkbox {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }

  /* ---------------- CHIP / PILL BUTTON STYLES ---------------- */
  .filter-bar__option-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    background: #F3F4F6;
    color: #374151;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .filter-bar__checkbox:hover + .filter-bar__option-label {
    background: #E5E7EB;
  }

  /* Active/selected state: solid blue pill, white text. */
  .filter-bar__checkbox:checked + .filter-bar__option-label {
    background: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
  }
  .filter-bar__checkbox:checked:hover + .filter-bar__option-label {
    background: #1D4ED8;
  }

  /* Keyboard-focus ring — the checkbox is visually hidden, so the
     focus indicator is drawn on the pill it sits on top of. */
  .filter-bar__checkbox:focus-visible + .filter-bar__option-label {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }

  /* ---------- Travel Schedule (custom calendar date picker) ----------
     A native <input type="date"> renders its popup UI (month/day
     names) in the browser/OS locale, which cannot be forced to
     English via CSS/JS. This lightweight custom picker guarantees
     the calendar text always renders in English, while its trigger
     is styled to read as a standard dropdown/select control — a
     bordered rectangle with a chevron, not a chip — deliberately
     distinct from the Region/Category/Accessibility pills above. */
  .filter-bar__group--date {
    position: relative;
  }

  .filter-bar__date-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 0.5rem;
    color: #111827;
    font: inherit;
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 120ms ease;
  }

  .filter-bar__date-trigger:hover {
    border-color: #9CA3AF;
  }

  .filter-bar__date-trigger[aria-expanded="true"] {
    border-color: #2563EB;
    box-shadow: 0 0 0 1px #2563EB;
  }

  .filter-bar__date-trigger:focus-visible {
    outline: 2px solid #2563EB;
    outline-offset: 1px;
  }

  [data-date-trigger-icon] {
    color: #6B7280;
    font-size: 0.7em;
  }

  .filter-bar__date-popup {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 10;
    width: 17rem;
    padding: 0.75rem;
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.12);
  }

  .filter-bar__date-popup[hidden] { display: none; }

  .filter-bar__date-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-weight: 700;
    color: #111827;
  }

  [data-date-prev],
  [data-date-next] {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: #374151;
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }
  [data-date-prev]:hover,
  [data-date-next]:hover {
    background: #F3F4F6;
  }

  .filter-bar__date-weekdays,
  .filter-bar__date-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .filter-bar__date-weekdays span {
    text-align: center;
    font-size: 0.75em;
    color: #6B7280;
  }

  .filter-bar__date-day {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: #111827;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .filter-bar__date-day:hover:not(:disabled) {
    background: #F3F4F6;
  }

  .filter-bar__date-day[data-outside="true"] {
    color: #D1D5DB;
    cursor: default;
  }

  .filter-bar__date-day[data-today="true"] {
    font-weight: 700;
    color: #2563EB;
  }

  /* Single-day selection, and the two range endpoints, are solid blue
     pills; days strictly between them get a soft blue fill with
     square-ish edges so the range reads as one continuous band. */
  .filter-bar__date-day[data-selected="true"],
  .filter-bar__date-day[data-range-start="true"],
  .filter-bar__date-day[data-range-end="true"] {
    background: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
  }

  .filter-bar__date-day[data-in-range="true"] {
    background: #DBEAFE;
    color: #1D4ED8;
    border-radius: 0;
  }

  .filter-bar__date-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid #E5E7EB;
  }

  .filter-bar__date-clear {
    border: none;
    background: none;
    color: #6B7280;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-bar__date-clear:hover {
    color: #DC2626;
  }

  /* ---------- Selected filter chips ---------- */
  .filter-bar__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    min-height: 1.75rem;
  }

  .filter-bar__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem 0.3rem 0.75rem;
    border-radius: 9999px;
    background: #EFF6FF;
    color: #1D4ED8;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .filter-bar__chip-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }

  .filter-bar__chip-remove:hover {
    background: rgba(29, 78, 216, 0.15);
  }

  /* Accessibility's applied-filter chip already gets its pill look
     from the nested verdict-badge — drop the generic blue chip
     background so it isn't double-pilled. */
  .filter-bar__chip[data-group="accessibility"] {
    background: none;
    padding: 0 0.3rem 0 0;
    color: inherit;
  }
  .filter-bar__chip[data-group="accessibility"] .filter-bar__chip-remove:hover {
    background: rgba(17, 24, 39, 0.08);
  }

  .filter-bar__clear-all {
    margin-left: auto;
    background: none;
    border: none;
    color: #6B7280;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .filter-bar__clear-all:hover {
    color: #DC2626;
  }

  /* ============================================================
     VERDICT-BADGE COMPONENT
     Inlined verbatim from verdict-badge.css (Owner: 명진) so this
     stays a single file. Do not hand-edit this block when the
     source file changes — repaste it instead. Our own additions
     live in the block that follows, clearly marked.
     ============================================================ */

  /*
   * Verdict Badge — shared component
   * Owner: 명진
   *
   * Common rule #2: a verdict is ALWAYS shown as an icon + label + color set.
   * Common rule #4: never invent a value. Missing/unknown -> "not-surveyed".
   *
   * Matches the approved design (아이콘_판정배지_기본 / _상세정보 / _커서댔을때):
   *   - Pill badge, no border by default.
   *   - On hover/focus: a 1px inset border appears in the same color.
   *   - On hover/focus (accessible / caution / difficult only): a detail
   *     tooltip appears above the badge with the full state name + a short
   *     explanation. "Not surveyed" has no tooltip — there's nothing to
   *     explain about data that doesn't exist yet.
   *
   * Three fixed sizes:
   *   --list   : dense rows inside a list/table
   *   --card   : default, inside a summary card
   *   --detail : large, top of a detail page
   */

  .verdict-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
    box-shadow: inset 0 0 0 1px transparent; /* border only appears on hover/focus */
    transition: box-shadow 0.1s ease;
  }

  .verdict-badge:hover,
  .verdict-badge:focus-visible {
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .verdict-badge__icon {
    display: inline-flex;
    flex-shrink: 0;
  }
  .verdict-badge__icon svg {
    display: block;
  }

  .verdict-badge__label {
    line-height: 1;
  }

  /* ---- Sizes ------------------------------------------------------- */

  .verdict-badge--list {
    height: 20px;
    padding: 0 8px;
    gap: 4px;
    font-size: 12px;
  }
  .verdict-badge--list .verdict-badge__icon svg {
    width: 12px;
    height: 12px;
  }

  .verdict-badge--card {
    height: 26px;
    padding: 0 10px;
    gap: 6px;
    font-size: 13px;
  }
  .verdict-badge--card .verdict-badge__icon svg {
    width: 14px;
    height: 14px;
  }

  .verdict-badge--detail {
    height: 36px;
    padding: 0 14px;
    gap: 8px;
    font-size: 16px;
    font-weight: 700;
  }
  .verdict-badge--detail .verdict-badge__icon svg {
    width: 18px;
    height: 18px;
  }

  /* ---- Color sets (exact values from the approved design file) ---- */

  /* ● Accessible / "All-Way" — green */
  .verdict-badge--accessible {
    color: #15803d;
    background: #e6f4ea;
  }

  /* ▲ Caution needed / "Step-Way" — amber/yellow */
  .verdict-badge--caution {
    color: #b06000;
    background: rgba(250, 204, 21, 0.16);
  }

  /* ■ Difficult / "Re-Way" — red */
  .verdict-badge--difficult {
    color: #c62828;
    background: #fce8e6;
  }

  /* ○ Not surveyed — gray (default / fallback, never fabricate a value) */
  .verdict-badge--not-surveyed {
    color: #5f6368;
    background: #f1f3f4;
  }

  .verdict-badge--muted {
    opacity: 0.72;
  }

  /* ---- Hover detail tooltip ----------------------------------------
   * Wrap the badge: <span class="verdict-badge-wrap"> badge + tooltip </span>
   * Only rendered for accessible / caution / difficult (see verdict-badge.js).
   */

  .verdict-badge-wrap {
    position: relative;
    display: inline-flex;
  }

  .verdict-badge-tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    width: 240px;
    padding: 16px;
    border-radius: 12px;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(12, 12, 13, 0.05),
      0 4px 8px rgba(12, 12, 13, 0.1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition: opacity 0.12s ease, transform 0.12s ease;
    z-index: 20;
  }

  .verdict-badge-tip::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    background: #ffffff;
    transform: translateX(-50%) rotate(45deg);
    box-shadow: 2px 2px 2px rgba(12, 12, 13, 0.05);
  }

  .verdict-badge-wrap:hover .verdict-badge-tip,
  .verdict-badge-wrap:focus-within .verdict-badge-tip {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .verdict-badge-tip__title {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 4px;
  }

  .verdict-badge-tip__desc {
    font-size: 13px;
    line-height: 1.45;
    color: #3c4043;
    margin: 0 0 12px;
  }

  .verdict-badge-tip__badge-row {
    display: flex;
  }

  /* ============================================================
     FILTER-BAR ADDITIONS ON TOP OF VERDICT-BADGE
     Everything above this line is verbatim from verdict-badge.css.
     Everything below is specific to using it as a filter chip.
     ============================================================ */

  /* Give the tooltip's repeated badge some breathing room above the
     title/description (their file only declares `display: flex`). */
  .verdict-badge-tip__badge-row {
    margin-bottom: 10px;
  }

  /* The Accessibility option no longer gets the generic gray/blue
     pill wrapper used by Region/Category — the verdict-badge color
     *is* the pill, so the wrapping <label> is reset to a plain,
     unstyled click target. */
  .filter-bar__option-label.filter-bar__option-label--verdict {
    padding: 0;
    background: none;
    border-radius: 0;
  }
  .filter-bar__checkbox--verdict:hover + .filter-bar__option-label--verdict,
  .filter-bar__checkbox--verdict:checked:hover + .filter-bar__option-label--verdict {
    background: none;
  }

  /* The checkbox driving a verdict chip is visually hidden (clipped
     to 1px, not the absolute-cover-the-pill technique used for
     Region/Category) so it no longer occludes the badge — this lets
     verdict-badge.css's own :hover/:focus-within selectors resolve
     against real mouse/keyboard hover of the visible badge. */
  .filter-bar__checkbox.filter-bar__checkbox--verdict {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    opacity: 1;
  }

  /* "Currently selected" reuses verdict-badge's own hover-border
     visual language (an inset ring in the badge's own color) rather
     than introducing an unrelated selection color — just thicker,
     so a checked-and-unhovered chip still reads as clearly active. */
  .filter-bar__checkbox--verdict:checked + .verdict-badge {
    box-shadow: inset 0 0 0 2px currentColor;
  }

  /* Keyboard-focus ring — drawn on the badge via the sibling
     selector, since the (visually hidden) checkbox is what actually
     receives focus, not the badge itself. */
  .filter-bar__checkbox--verdict:focus-visible + .verdict-badge {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }
</style>
</head>
<body>

  <!-- ================================================================
       COMPONENT MARKUP
       Everything the JS needs is addressed via data-* attributes, so
       every class below (filter-bar__*, verdict-badge*) is free to be
       restyled or renamed by the design team without touching
       behavior. To embed elsewhere, copy this <section> plus the
       <script> block near the end of <body>.
       ================================================================ -->
  <section class="filter-bar" data-component="filter-bar" aria-label="Destination filters">

    <form class="filter-bar__form" data-filter-form novalidate>

      <fieldset class="filter-bar__group" data-filter-group="region">
        <legend class="filter-bar__legend">Region</legend>
        <div class="filter-bar__options" data-options></div>
      </fieldset>

      <fieldset class="filter-bar__group" data-filter-group="category">
        <legend class="filter-bar__legend">Category</legend>
        <div class="filter-bar__options" data-options></div>
      </fieldset>

      <fieldset class="filter-bar__group" data-filter-group="accessibility">
        <legend class="filter-bar__legend">Accessibility</legend>
        <div class="filter-bar__options" data-options></div>
      </fieldset>

      <div class="filter-bar__group filter-bar__group--date" data-filter-group="date">
        <span class="filter-bar__legend" data-date-label>Travel Schedule</span>

        <button type="button"
                class="filter-bar__date-trigger"
                data-date-trigger
                aria-haspopup="dialog"
                aria-expanded="false">
          <span data-date-trigger-text>Select a date</span>
          <span aria-hidden="true" data-date-trigger-icon>&#9662;</span>
        </button>

        <div class="filter-bar__date-popup"
             data-date-popup
             role="dialog"
             aria-modal="false"
             aria-label="Choose a travel date"
             hidden>
          <div class="filter-bar__date-header">
            <button type="button" data-date-prev aria-label="Previous month">&#8249;</button>
            <span data-date-month aria-live="polite"></span>
            <button type="button" data-date-next aria-label="Next month">&#8250;</button>
          </div>
          <div class="filter-bar__date-weekdays" aria-hidden="true">
            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
          </div>
          <div class="filter-bar__date-grid" data-date-grid></div>
          <div class="filter-bar__date-footer">
            <button type="button" class="filter-bar__date-clear" data-date-clear>Clear date</button>
          </div>
        </div>
      </div>

    </form>

    <!-- Selected-filter chips -->
    <div class="filter-bar__chips" data-chips aria-live="polite">
      <span data-chips-empty>No filters applied</span>
      <button type="button" class="filter-bar__clear-all" data-clear-all hidden>Clear All</button>
    </div>

  </section>

  <script>
  /**
   * Tourism Filter Search Bar — standalone, dependency-free component.
   *
   * Usage
   * -----
   * Drop the <section data-component="filter-bar"> markup above
   * anywhere in a page (more than one instance is supported) and
   * include this script once. Each instance auto-initializes on
   * DOMContentLoaded and exposes its state on the root element:
   *
   *   const bar = document.querySelector('[data-component="filter-bar"]');
   *   bar.addEventListener('filterbar:change', (e) => {
   *     console.log(e.detail.state);
   *     // { region: [], category: [], accessibility: [],
   *     //   date: null | { start: 'YYYY-MM-DD', end: 'YYYY-MM-DD', mode: 'single' | 'range' } }
   *     console.log(e.detail.matches); // (item) => boolean, see buildMatcher() below
   *   });
   *
   * Filtering logic
   * ---------------
   * OR within a single filter group, AND across different groups —
   * i.e. checking both "Gwanghwamun" and "Yongsan" broadens results
   * to either region, while also checking "Accessible" narrows those
   * results down to accessible places in either region.
   *
   * The `matches(item)` helper expects items shaped like:
   *   { region: 'gwanghwamun', categories: ['history'], accessibility: 'accessible', closedDays: [1] }
   * (closedDays is optional — an array of 0–6 weekday numbers the
   * item is unavailable, used against the Travel Schedule filter.)
   * Adapt buildMatcher() if a consuming page's data shape differs.
   *
   * Travel Schedule (single date / date range)
   * -------------------------------------------
   * The calendar cycles through a 3-click pattern:
   *   1st click  -> selects a single day                 ("Aug 12, 2026")
   *   2nd click  -> extends that day into a range with    ("Aug 12, 2026 ~ Aug 15, 2026")
   *                 whichever date was clicked (order-independent)
   *   3rd click  -> discards the previous selection and starts
   *                 a new single-day selection at the clicked date
   * A single date matches an item if the item is available (not in
   * `closedDays`) on that date. A range matches an item if the item
   * is available on *any* date within the range.
   */
  (function () {
    "use strict";

    var REGION_OPTIONS = [
      { value: "gwanghwamun", label: "Gwanghwamun" },
      { value: "yongsan", label: "Yongsan" }
    ];

    var CATEGORY_OPTIONS = [
      { value: "history", label: "History & Heritage" },
      { value: "arts", label: "Arts & Culture" },
      { value: "nature", label: "Nature & Leisure" },
      { value: "shopping", label: "Shopping & Entertainment" }
    ];

    // `cssModifier` is the verdict-badge modifier suffix, e.g.
    // "verdict-badge--" + cssModifier -> "verdict-badge--accessible".
    // Our internal `value` stays "unsurveyed" (used throughout the
    // matching/state logic) even though verdict-badge.css's class is
    // the hyphenated "not-surveyed" — cssModifier bridges the two.
    // `label` uses the exact product terminology from the reference
    // (All-Way / Step-Way / Re-Way), not the generic English
    // description — that fuller phrase now lives in tooltipTitle
    // instead. tooltipDesc is still placeholder copy (not the actual
    // approved microcopy) — swap in the real text from 명진/content
    // before shipping. "Not surveyed" intentionally has no tooltip,
    // per verdict-badge.css's own comment ("nothing to explain about
    // data that doesn't exist yet").
    var ACCESSIBILITY_OPTIONS = [
      {
        value: "accessible", label: "All-Way", cssModifier: "accessible", // ●
        tooltipTitle: "All-Way Accessible",
        tooltipDesc: "The route from the entrance to key facilities is step-free and confirmed accessible for wheelchairs and other mobility devices."
      },
      {
        value: "caution", label: "Step-Way", cssModifier: "caution", // ▲
        tooltipTitle: "Step-Way (Caution Needed)",
        tooltipDesc: "Some sections include steps, slopes, or uneven surfaces. Assistance or an alternate path may be needed along the way."
      },
      {
        value: "difficult", label: "Re-Way", cssModifier: "difficult", // ■
        tooltipTitle: "Re-Way (Difficult Access)",
        tooltipDesc: "The main route isn't accessible. Check for an alternate entrance or route before visiting, or contact the venue directly."
      },
      { value: "unsurveyed", label: "Not surveyed", cssModifier: "not-surveyed" } // ○ — no tooltip
    ];

    // Placeholder icons matching this project's established ●▲■○
    // icon language — swap for 명진's real icon SVGs when available.
    var VERDICT_ICONS = {
      accessible: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle></svg>',
      caution: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5L23 21H1L12 2.5Z"></path></svg>',
      difficult: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect></svg>',
      unsurveyed: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle></svg>'
    };

    var MONTH_NAMES = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    var LABEL_LOOKUP = {
      region: toMap(REGION_OPTIONS),
      category: toMap(CATEGORY_OPTIONS),
      accessibility: toMap(ACCESSIBILITY_OPTIONS)
    };

    function toMap(list) {
      var map = {};
      list.forEach(function (opt) { map[opt.value] = opt; });
      return map;
    }

    /* ---------------- date formatting & availability helpers ----------------
       Shared across instances — pure functions, no component state. */

    // "Aug 12, 2026"
    function formatSingleDate(isoDate) {
      var d = new Date(isoDate + "T00:00:00");
      return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    }

    // "Aug 12, 2026" (single) or "Aug 12, 2026 ~ Aug 15, 2026" (range)
    function formatDateSelection(startIso, endIso) {
      if (!startIso) return "";
      if (startIso === endIso) return formatSingleDate(startIso);
      return formatSingleDate(startIso) + " ~ " + formatSingleDate(endIso);
    }

    function isDateAvailable(item, iso) {
      if (!item || !item.closedDays) return true;
      var weekday = new Date(iso + "T00:00:00").getDay();
      return item.closedDays.indexOf(weekday) === -1;
    }

    // True if `item` is available on at least one day within [startIso, endIso].
    function isAvailableInRange(item, startIso, endIso) {
      if (!item || !item.closedDays) return true;
      var cursor = new Date(startIso + "T00:00:00");
      var end = new Date(endIso + "T00:00:00");
      while (cursor <= end) {
        var weekday = cursor.getDay();
        if (item.closedDays.indexOf(weekday) === -1) return true;
        cursor.setDate(cursor.getDate() + 1);
      }
      return false;
    }

    var instanceCounter = 0;

    function initFilterBar(root) {
      instanceCounter += 1;
      var uid = "filter-bar-" + instanceCounter;

      var state = {
        region: new Set(),
        category: new Set(),
        accessibility: new Set(),
        // Travel Schedule: dateStart/dateEnd hold ISO dates ("" = none
        // selected). dateRangeComplete tracks where we are in the
        // 3-click cycle: false = the next click extends dateStart into
        // a range; true = the next click resets and starts a fresh
        // single-day selection. See the top-of-file doc comment.
        dateStart: "",
        dateEnd: "",
        dateRangeComplete: false
      };

      var regionContainer = root.querySelector('[data-filter-group="region"] [data-options]');
      var categoryContainer = root.querySelector('[data-filter-group="category"] [data-options]');
      var accessibilityContainer = root.querySelector('[data-filter-group="accessibility"] [data-options]');

      var dateTrigger = root.querySelector("[data-date-trigger]");
      var dateTriggerText = root.querySelector("[data-date-trigger-text]");
      var datePopup = root.querySelector("[data-date-popup]");
      var datePrevBtn = root.querySelector("[data-date-prev]");
      var dateNextBtn = root.querySelector("[data-date-next]");
      var dateMonthLabel = root.querySelector("[data-date-month]");
      var dateGrid = root.querySelector("[data-date-grid]");
      var dateClearBtn = root.querySelector("[data-date-clear]");

      var chipsContainer = root.querySelector("[data-chips]");
      var chipsEmptyHint = root.querySelector("[data-chips-empty]");
      var clearAllBtn = root.querySelector("[data-clear-all]");

      /* ---------------- build checkbox groups ---------------- */
      function buildOptionGroup(container, groupName, options) {
        options.forEach(function (opt) {
          // Accessibility options get the real verdict-badge markup
          // (see buildVerdictOption) instead of the generic gray/blue
          // pill used for Region/Category.
          if (opt.cssModifier) {
            container.appendChild(buildVerdictOption(opt, groupName));
            return;
          }

          var wrapper = document.createElement("div");
          wrapper.className = "filter-bar__option";
          wrapper.setAttribute("data-value", opt.value);

          var inputId = uid + "-" + groupName + "-" + opt.value;

          var input = document.createElement("input");
          input.type = "checkbox";
          input.className = "filter-bar__checkbox";
          input.id = inputId;
          input.name = uid + "-" + groupName;
          input.value = opt.value;

          var label = document.createElement("label");
          label.className = "filter-bar__option-label";
          label.setAttribute("for", inputId);
          label.appendChild(document.createTextNode(opt.label));

          input.addEventListener("change", function () {
            if (input.checked) {
              state[groupName].add(opt.value);
            } else {
              state[groupName].delete(opt.value);
            }
            emitChange();
          });

          wrapper.appendChild(input);
          wrapper.appendChild(label);
          container.appendChild(wrapper);
        });
      }

      // Builds a plain verdict-badge element (icon + label + color),
      // reused both for the filter option pill and the selected-chip
      // row — pass the verdict-badge.css size class to use for each.
      function buildVerdictBadge(opt, sizeClass) {
        var badge = document.createElement("span");
        badge.className = "verdict-badge " + (sizeClass || "verdict-badge--card") + " verdict-badge--" + opt.cssModifier;
        badge.setAttribute("data-verdict", opt.value);

        var icon = document.createElement("span");
        icon.className = "verdict-badge__icon";
        icon.setAttribute("aria-hidden", "true");
        icon.innerHTML = VERDICT_ICONS[opt.value] || "";

        var text = document.createElement("span");
        text.className = "verdict-badge__label";
        text.textContent = opt.label;

        badge.appendChild(icon);
        badge.appendChild(text);
        return badge;
      }

      // Full Accessibility filter option: a checkbox (visually
      // hidden, not overlaid — see .filter-bar__checkbox--verdict)
      // plus the verdict-badge, both inside a <label> so the whole
      // badge is the click target; the hover-detail tooltip sits as
      // a sibling (not inside the label) so hovering/reading it
      // never toggles the checkbox underneath.
      function buildVerdictOption(opt, groupName) {
        var wrapper = document.createElement("div");
        wrapper.className = "filter-bar__option filter-bar__option--verdict";
        wrapper.setAttribute("data-value", opt.value);

        var badgeWrap = document.createElement("span");
        badgeWrap.className = "verdict-badge-wrap";

        var inputId = uid + "-" + groupName + "-" + opt.value;

        var input = document.createElement("input");
        input.type = "checkbox";
        input.className = "filter-bar__checkbox filter-bar__checkbox--verdict";
        input.id = inputId;
        input.name = uid + "-" + groupName;
        input.value = opt.value;
        input.addEventListener("change", function () {
          if (input.checked) {
            state[groupName].add(opt.value);
          } else {
            state[groupName].delete(opt.value);
          }
          emitChange();
        });

        var label = document.createElement("label");
        label.className = "filter-bar__option-label filter-bar__option-label--verdict";
        label.appendChild(input);
        label.appendChild(buildVerdictBadge(opt, "verdict-badge--card"));

        badgeWrap.appendChild(label);

        // "Not surveyed" has no tooltip, per verdict-badge.css's comment.
        if (opt.tooltipTitle) {
          badgeWrap.appendChild(buildVerdictTooltip(opt));
        }

        wrapper.appendChild(badgeWrap);
        return wrapper;
      }

      function buildVerdictTooltip(opt) {
        var tip = document.createElement("span");
        tip.className = "verdict-badge-tip";
        tip.setAttribute("role", "tooltip");

        var row = document.createElement("span");
        row.className = "verdict-badge-tip__badge-row";
        row.appendChild(buildVerdictBadge(opt, "verdict-badge--card"));

        var title = document.createElement("p");
        title.className = "verdict-badge-tip__title";
        title.textContent = opt.tooltipTitle;

        var desc = document.createElement("p");
        desc.className = "verdict-badge-tip__desc";
        desc.textContent = opt.tooltipDesc;

        tip.appendChild(row);
        tip.appendChild(title);
        tip.appendChild(desc);
        return tip;
      }

      buildOptionGroup(regionContainer, "region", REGION_OPTIONS);
      buildOptionGroup(categoryContainer, "category", CATEGORY_OPTIONS);
      buildOptionGroup(accessibilityContainer, "accessibility", ACCESSIBILITY_OPTIONS);

      /* ---------------- Travel Schedule calendar ---------------- */
      var calendarYear, calendarMonth;

      function pad2(n) { return n < 10 ? "0" + n : String(n); }
      function toIsoDate(y, m, d) { return y + "-" + pad2(m + 1) + "-" + pad2(d); }

      function setCalendarView(isoDate) {
        var base = isoDate ? new Date(isoDate + "T00:00:00") : new Date();
        calendarYear = base.getFullYear();
        calendarMonth = base.getMonth();
      }

      function renderCalendar() {
        dateMonthLabel.textContent = MONTH_NAMES[calendarMonth] + " " + calendarYear;
        dateGrid.innerHTML = "";

        var firstWeekday = new Date(calendarYear, calendarMonth, 1).getDay();
        var daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
        var daysInPrevMonth = new Date(calendarYear, calendarMonth, 0).getDate();
        var today = new Date();
        var todayIso = toIsoDate(today.getFullYear(), today.getMonth(), today.getDate());
        var totalCells = Math.ceil((firstWeekday + daysInMonth) / 7) * 7;

        for (var i = 0; i < totalCells; i++) {
          var dayNumber = i - firstWeekday + 1;
          var cellYear = calendarYear, cellMonth = calendarMonth, cellDay = dayNumber, isOutside = false;

          if (dayNumber < 1) {
            cellMonth = calendarMonth - 1;
            cellYear = cellMonth < 0 ? calendarYear - 1 : calendarYear;
            cellMonth = (cellMonth + 12) % 12;
            cellDay = daysInPrevMonth + dayNumber;
            isOutside = true;
          } else if (dayNumber > daysInMonth) {
            cellDay = dayNumber - daysInMonth;
            cellMonth = calendarMonth + 1;
            cellYear = cellMonth > 11 ? calendarYear + 1 : calendarYear;
            cellMonth = cellMonth % 12;
            isOutside = true;
          }

          var cellIso = toIsoDate(cellYear, cellMonth, cellDay);
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className = "filter-bar__date-day";
          btn.textContent = String(cellDay);
          btn.setAttribute("aria-label", MONTH_NAMES[cellMonth] + " " + cellDay + ", " + cellYear);

          if (isOutside) {
            btn.setAttribute("data-outside", "true");
            btn.disabled = true;
            btn.tabIndex = -1;
          } else {
            if (cellIso === todayIso) btn.setAttribute("data-today", "true");

            // Selection state hooks for styling (see the
            // .filter-bar__date-day[data-...] rules above):
            //   data-selected     single date selected
            //   data-range-start  first day of a completed range
            //   data-range-end    last day of a completed range
            //   data-in-range     a day strictly between start and end
            if (state.dateStart) {
              if (state.dateStart === state.dateEnd) {
                if (cellIso === state.dateStart) btn.setAttribute("data-selected", "true");
              } else {
                if (cellIso === state.dateStart) btn.setAttribute("data-range-start", "true");
                if (cellIso === state.dateEnd) btn.setAttribute("data-range-end", "true");
                if (cellIso > state.dateStart && cellIso < state.dateEnd) btn.setAttribute("data-in-range", "true");
              }
            }

            // stopPropagation matters here: handleDayClick() rebuilds the
            // grid synchronously, detaching this button before the click
            // event would otherwise bubble to the document-level
            // outside-click listener — which would then see a detached
            // target and incorrectly close the popup.
            btn.addEventListener("click", function (e) {
              e.stopPropagation();
              handleDayClick(this.getAttribute("data-iso"));
            });
            btn.setAttribute("data-iso", cellIso);
          }

          dateGrid.appendChild(btn);
        }
      }

      function updateDateTriggerText() {
        dateTriggerText.textContent = state.dateStart
          ? formatDateSelection(state.dateStart, state.dateEnd)
          : "Select a date";
      }

      function openDatePopup() {
        setCalendarView(state.dateStart);
        renderCalendar();
        datePopup.hidden = false;
        dateTrigger.setAttribute("aria-expanded", "true");
      }

      function closeDatePopup() {
        datePopup.hidden = true;
        dateTrigger.setAttribute("aria-expanded", "false");
      }

      // Implements the 3-click cycle described in the top-of-file doc
      // comment. The popup intentionally stays open after each click so
      // the user can immediately make the next click in the cycle; it
      // closes via the trigger button, an outside click, Escape, or
      // "Clear date".
      function handleDayClick(iso) {
        if (!state.dateStart || state.dateRangeComplete) {
          // 1st click of a cycle (or the "3rd click" reset case).
          state.dateStart = iso;
          state.dateEnd = iso;
          state.dateRangeComplete = false;
        } else {
          // 2nd click of a cycle: complete the range, normalizing order
          // so dateStart is always the earlier date.
          if (iso < state.dateStart) {
            state.dateEnd = state.dateStart;
            state.dateStart = iso;
          } else {
            state.dateEnd = iso;
          }
          state.dateRangeComplete = true;
        }

        updateDateTriggerText();
        renderCalendar();
        emitChange();
      }

      dateTrigger.addEventListener("click", function (e) {
        e.stopPropagation();
        datePopup.hidden ? openDatePopup() : closeDatePopup();
      });
      datePrevBtn.addEventListener("click", function () {
        calendarMonth -= 1;
        if (calendarMonth < 0) { calendarMonth = 11; calendarYear -= 1; }
        renderCalendar();
      });
      dateNextBtn.addEventListener("click", function () {
        calendarMonth += 1;
        if (calendarMonth > 11) { calendarMonth = 0; calendarYear += 1; }
        renderCalendar();
      });
      dateClearBtn.addEventListener("click", function () {
        state.dateStart = "";
        state.dateEnd = "";
        state.dateRangeComplete = false;
        updateDateTriggerText();
        closeDatePopup();
        emitChange();
      });
      document.addEventListener("click", function (e) {
        if (!datePopup.hidden && !datePopup.contains(e.target) && e.target !== dateTrigger) {
          closeDatePopup();
        }
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !datePopup.hidden) {
          closeDatePopup();
          dateTrigger.focus();
        }
      });

      /* ---------------- chips ---------------- */
      function renderChips() {
        Array.prototype.slice.call(chipsContainer.querySelectorAll("[data-chip]")).forEach(function (el) {
          el.remove();
        });

        var chips = [];
        state.region.forEach(function (v) {
          chips.push({ group: "region", value: v, node: textChipNode(LABEL_LOOKUP.region[v].label) });
        });
        state.category.forEach(function (v) {
          chips.push({ group: "category", value: v, node: textChipNode(LABEL_LOOKUP.category[v].label) });
        });
        state.accessibility.forEach(function (v) {
          var opt = LABEL_LOOKUP.accessibility[v];
          chips.push({ group: "accessibility", value: v, node: buildVerdictBadge(opt, "verdict-badge--list") });
        });
        if (state.dateStart) {
          chips.push({
            group: "date",
            value: state.dateStart + (state.dateEnd !== state.dateStart ? "_" + state.dateEnd : ""),
            node: textChipNode(formatDateSelection(state.dateStart, state.dateEnd))
          });
        }

        chipsEmptyHint.hidden = chips.length > 0;
        clearAllBtn.hidden = chips.length === 0;

        chips.forEach(function (chip) {
          var chipEl = document.createElement("span");
          chipEl.className = "filter-bar__chip";
          chipEl.setAttribute("data-chip", "");
          chipEl.setAttribute("data-group", chip.group);
          chipEl.setAttribute("data-value", chip.value);

          chipEl.appendChild(chip.node);

          var removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.className = "filter-bar__chip-remove";
          removeBtn.setAttribute("aria-label", "Remove filter");
          removeBtn.textContent = "×"; // ×
          removeBtn.addEventListener("click", function () { removeChip(chip.group, chip.value); });

          chipEl.appendChild(removeBtn);
          chipsContainer.insertBefore(chipEl, clearAllBtn);
        });
      }

      function textChipNode(text) {
        var span = document.createElement("span");
        span.className = "filter-bar__chip-label";
        span.textContent = text;
        return span;
      }

      function removeChip(group, value) {
        if (group === "date") {
          state.dateStart = "";
          state.dateEnd = "";
          state.dateRangeComplete = false;
          updateDateTriggerText();
        } else {
          state[group].delete(value);
          var input = root.querySelector(
            '.filter-bar__option[data-value="' + cssEscape(value) + '"] input[name="' + uid + "-" + group + '"]'
          );
          if (input) input.checked = false;
        }
        emitChange();
      }

      function cssEscape(value) {
        return value.replace(/"/g, '\\"');
      }

      function clearAll() {
        state.region.clear();
        state.category.clear();
        state.accessibility.clear();
        state.dateStart = "";
        state.dateEnd = "";
        state.dateRangeComplete = false;

        root.querySelectorAll(".filter-bar__checkbox").forEach(function (input) {
          input.checked = false;
        });
        updateDateTriggerText();
        closeDatePopup();

        emitChange();
      }

      clearAllBtn.addEventListener("click", clearAll);

      /* ---------------- OR/AND matching + change event ---------------- */
      function buildMatcher() {
        return function matches(item) {
          var regionOk = state.region.size === 0 || state.region.has(item.region);

          var categoryOk =
            state.category.size === 0 ||
            (item.categories || []).some(function (c) { return state.category.has(c); });

          var accessibilityOk =
            state.accessibility.size === 0 || state.accessibility.has(item.accessibility);

          var dateOk = true;
          if (state.dateStart) {
            dateOk = state.dateStart === state.dateEnd
              ? isDateAvailable(item, state.dateStart)
              : isAvailableInRange(item, state.dateStart, state.dateEnd);
          }

          return regionOk && categoryOk && accessibilityOk && dateOk;
        };
      }

      function getDateState() {
        return state.dateStart
          ? {
              start: state.dateStart,
              end: state.dateEnd,
              mode: state.dateStart === state.dateEnd ? "single" : "range"
            }
          : null;
      }

      function emitChange() {
        renderChips();
        root.dispatchEvent(new CustomEvent("filterbar:change", {
          bubbles: true,
          detail: {
            state: {
              region: Array.from(state.region),
              category: Array.from(state.category),
              accessibility: Array.from(state.accessibility),
              date: getDateState()
            },
            matches: buildMatcher()
          }
        }));
      }

      // Initial paint (empty state / hints).
      updateDateTriggerText();
      renderChips();

      // Expose per-instance API for consumers that prefer method calls
      // over listening for the event (e.g. `bar.filterBar.clearAll()`).
      root.filterBar = {
        getState: function () {
          return {
            region: Array.from(state.region),
            category: Array.from(state.category),
            accessibility: Array.from(state.accessibility),
            date: getDateState()
          };
        },
        buildMatcher: buildMatcher,
        clearAll: clearAll
      };
    }

    function init() {
      document.querySelectorAll('[data-component="filter-bar"]').forEach(initFilterBar);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
  </script>

</body>
</html>
